# shellcheck shell=bash
# pacman exécute ce scriptlet sous /bin/sh, qui est bash sur Arch (le paquet
# dépend de bash) : les motifs [[ ]] sont volontaires.
post_install() {
    # Contrairement à `make install`, pacman n'active rien : sans ceci le timer
    # reste inerte et rien ne monte tant que le hook réseau n'a pas parlé.
    # 1.25 : unités et hooks renommés (nfs -> nas). pacman retire les fichiers
    # de l'ancien paquet, mais pas les liens d'activation du timer ni une copie
    # posée hors paquet : on nettoie explicitement.
    systemctl disable --now nfs-network-check.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/nfs-network-check.service \
          /etc/systemd/system/nfs-network-check.timer \
          /etc/systemd/system/timers.target.wants/nfs-network-check.timer \
          /etc/systemd/system/multi-user.target.wants/nfs-network-check.timer \
          /etc/NetworkManager/dispatcher.d/98-eth-nfs-mac \
          /etc/NetworkManager/dispatcher.d/99-wifi-nfs-mount
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now nas-network-check.timer >/dev/null 2>&1 || true

    # Le questionnaire n'a de sens que sans configuration : sur une mise à jour
    # d'un poste déjà configuré, ce bloc annonçait « aucun partage » alors que
    # /etc/smart-mount/config existait et restait intact (le paquet ne le touche
    # pas). Les conseils de premier lancement n'étaient donc que du bruit.
    if [[ ! -r /etc/smart-mount/config ]]; then
        cat <<'EOF'
smart-mount est installé, mais aucun partage n'est configuré.

  1. lancer le questionnaire (il écrit /etc/smart-mount/config) :
         sudo nas-smartmount.sh setup

  2. vérifier la décision sans rien monter :
         sudo SMARTMOUNT_DRY_RUN=1 nas-smartmount.sh apply

  3. voir l'état des montages :
         sudo nas-smartmount.sh show

Sans MAC cible, un partage ne monte jamais (code de sortie 4) : la MAC se lit
avec `ip neigh show <IP_DU_SERVEUR>`, ou dans les baux DHCP de la box.

Pour lire la configuration sans sudo avec `show`, créer un groupe dédié :
    sudo groupadd -r smartmount
    sudo usermod -aG smartmount "$USER"
    sudo chgrp smartmount /etc/smart-mount/config
puis relancer la session.

Si l'action polkit n'apparaît pas (pkaction --action-id
org.jotenakis.smartmount.manage), relancer polkit une fois :
    sudo systemctl restart polkit
EOF
    else
        cat <<'EOF'
smart-mount est installé ; /etc/smart-mount/config est conservé.

Voir l'état des montages :
        sudo nas-smartmount.sh show
EOF
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now nas-network-check.timer nfs-network-check.timer 2>/dev/null || true
    cat <<'EOF'
Le fichier /etc/smart-mount/config et les fichiers d'identifiants CIFS ne
appartiennent pas au paquet : ils sont laissés en place. Supprimez-les à la main
si vous voulez repartir de zéro.
EOF
}
