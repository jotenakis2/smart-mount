#!/usr/bin/env bash

set -euo pipefail

readonly CONFIG="${SMARTMOUNT_CONFIG:-/etc/smart-mount/config}"
if [[ -f "${CONFIG}" ]]; then
	# shellcheck source=/etc/smart-mount/config
	source "${CONFIG}"
else
	echo "config missing"
	exit 1
fi

# Une config antérieure à l'ajout du champ ne doit pas casser le hook via set -u.
LAN_IFACE="${LAN_IFACE:-}"

readonly DEVICE="${1:-}"
readonly STATE="${2:-}"
readonly SCRIPT_NAME="smartmount-eth-nfs-NM_hook"
readonly MAIN_SCRIPT="${SMARTMOUNT_MAIN:-/usr/local/bin/nfs-smartmount.sh}"

log_info() {
    if command -v logger >/dev/null 2>&1; then
        logger -t "${SCRIPT_NAME}" -p user.info -- "$*"
    else
        printf '%s\n' "$*" >&2
    fi
}

log_err() {
    if command -v logger >/dev/null 2>&1; then
        logger -t "${SCRIPT_NAME}" -p user.err -- "$*"
    else
        printf '%s\n' "$*" >&2
    fi
}

trap_err() {
    local exit_code="${1}"
    local line_number="${2}"
    log_err "Error at line ${line_number}, code ${exit_code}"
}

trap 'trap_err "$?" "${LINENO}"' ERR

main() {
    if [[ "${DEVICE}" != "${LAN_IFACE}" ]]; then
        return 0
    fi

    log_info "Event: device=${DEVICE}, state=${STATE}"

    case "${STATE}" in
        up|dhcp4-change|dhcp6-change|connectivity-change|reapply|down|vpn-down)
            # Le hook ne décide plus (ni MAC, ni montage ni démontage) : il
            # déclenche la politique unique du script principal, qui regarde le
            # Wi-Fi ET l'Ethernet. C'est ce qui empêche les deux hooks de se
            # contredire quand les deux liens sont actifs.
            "${MAIN_SCRIPT}" apply || log_err "smart-mount policy run failed"
            ;;
        *)
            log_info "State ignored: ${STATE}"
            ;;
    esac
}

main
