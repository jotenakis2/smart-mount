#!/usr/bin/env bash

set -euo pipefail
readonly CONFIG="/etc/smart-mount/config"
if [[ -f "${CONFIG}" ]]; then
	# shellcheck source=/etc/smart-mount/config
	source "${CONFIG}"
else
	echo "config manquante"
	exit 1
fi

# Une config antérieure à l'ajout du champ ne doit pas casser le hook via set -u.
WIFI_IFACE="${WIFI_IFACE:-}"

readonly DEVICE="${1:-}"
readonly STATE="${2:-}"
readonly SCRIPT_NAME="smartmount-wifi-nfs-NM_hook"
readonly MAIN_SCRIPT="/usr/local/bin/nfs-smartmount.sh"

log_info() {
    logger -t "${SCRIPT_NAME}" -p user.info -- "$*"
}

log_notice() {
    logger -t "${SCRIPT_NAME}" -p user.notice -- "$*"
}

log_err() {
    logger -t "${SCRIPT_NAME}" -p user.err -- "$*"
}

trap_err() {
    local exit_code="${1}"
    local line_number="${2}"
    log_err "Erreur ligne ${line_number}, code ${exit_code}"
}

trap 'trap_err "$?" "${LINENO}"' ERR

main() {
    if [[ "${DEVICE}" != "${WIFI_IFACE}" ]]; then
        return 0
    fi

    log_info "Event: device=${DEVICE}, state=${STATE}"

    case "${STATE}" in
        up|dhcp4-change|dhcp6-change|connectivity-change|reapply)
            # Le hook ne décide plus : il déclenche la politique unique du
            # script principal, qui monte, démonte ou s'abstient selon l'état
            # réseau complet (SSID ciblé, SSID illisible).
            "${MAIN_SCRIPT}" apply || log_err "Application de la politique smart-mount en échec"
            ;;
        down|vpn-down)
            # Ici la coupure est un fait, pas une politique : on démonte sans
            # dépendre de ce que répondra une lecture d'interface juste après.
            log_notice "Lien WiFi coupé, démontage NFS"
            "${MAIN_SCRIPT}" unmount || log_err "Démontage NFS en échec"
            ;;
        *)
            log_info "État ignoré: ${STATE}"
            ;;
    esac
}

main
