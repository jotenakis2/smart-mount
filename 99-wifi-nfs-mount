#!/usr/bin/env bash

set -euo pipefail
readonly CONFIG="${SMARTMOUNT_CONFIG:-/etc/smart-mount/config}"
if [[ -f "${CONFIG}" ]]; then
	# shellcheck source=/etc/smart-mount/config
	source "${CONFIG}"
else
	echo "config manquante"
	exit 1
fi

# Une config antérieure à l'ajout du champ ne doit pas casser le hook via set -u.
WIFI_IFACE="${WIFI_IFACE:-}"

readonly DEVICE="${1:-}"
readonly STATE="${2:-}"
readonly SCRIPT_NAME="smartmount-wifi-nfs-NM_hook"
readonly MAIN_SCRIPT="${SMARTMOUNT_MAIN:-/usr/local/bin/nfs-smartmount.sh}"

log_info() {
    logger -t "${SCRIPT_NAME}" -p user.info -- "$*"
}

log_notice() {
    logger -t "${SCRIPT_NAME}" -p user.notice -- "$*"
}

log_err() {
    logger -t "${SCRIPT_NAME}" -p user.err -- "$*"
}

trap_err() {
    local exit_code="${1}"
    local line_number="${2}"
    log_err "Erreur ligne ${line_number}, code ${exit_code}"
}

trap 'trap_err "$?" "${LINENO}"' ERR

main() {
    if [[ "${DEVICE}" != "${WIFI_IFACE}" ]]; then
        return 0
    fi

    log_info "Event: device=${DEVICE}, state=${STATE}"

    case "${STATE}" in
        up|dhcp4-change|dhcp6-change|connectivity-change|reapply|down|vpn-down)
            # Le hook ne décide plus : il déclenche la politique unique du
            # script principal, qui regarde le Wi-Fi ET l'Ethernet. Un démontage
            # unilatéral sur `down` défaisait le montage justifié par l'autre
            # lien (portable docké, Wi-Fi coupé).
            "${MAIN_SCRIPT}" apply || log_err "Application de la politique smart-mount en échec"
            ;;
        *)
            log_info "État ignoré: ${STATE}"
            ;;
    esac
}

main
